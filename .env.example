# YOUTUBE_API_KEY: Required for YouTube Data API v3 public calls (videos, channels, search, thumbnails, tags, trends, statistics).
# Configure this key via the Secrets panel in the AI Studio UI.
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY

# YOUTUBE_OAUTH_CLIENT_ID: Optional OAuth 2.0 Web/Android Client ID for YouTube Analytics API & channel authorization.
# If left as the placeholder, ZEDCraft uses the provisioned Google Sign-In Web Client ID.
YOUTUBE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# GITHUB_REPO: Optional GitHub repository (owner/repo) for checking ZEDCraft app updates via GitHub Releases & Commits.
GITHUB_REPO=khalil4ever/ZEDCraft-

# GITHUB_TOKEN: Optional GitHub Personal Access Token to create the ZEDCraft repo or check private releases via GitHub API.
GITHUB_TOKEN=YOUR_GITHUB_PERSONAL_ACCESS_TOKEN
